          <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-black"><iframe title="কেন্দ্রীয় শহীদ মিনার — গুগল মানচিত্র" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6249.30973029436!2d90.3940500770538!3d23.7272379786862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755b8e89cbec039%3A0xe403f93b9b07d016!2sCentral%20Shaheed%20Minar!5e1!3m2!1sbn!2sBD!4v1788751034003!5m2!1sbn!2sBD" width="100%" height="520" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
          <div class="mt-6 grid gap-4 sm:grid-cols-3"><div><p class="text-xs text-stone-500">ঠিকানা</p><p class="mt-1 font-bold">ঢাকা মেডিকেল কলেজ গেটের কাছে, সেক্রেটারিয়েট রোড, ঢাকা ১০০০</p></div><div><p class="text-xs text-stone-500">স্থানাঙ্ক</p><p class="mt-1 font-bold">২৩.৭২৭২৩৮, ৯০.৩৯৬৬২৫</p></div><div><p class="text-xs text-stone-500">প্লাস কোড</p><p class="mt-1 font-bold">P9GW+VJ, ঢাকা</p></div></div>
        </div>
      </section>

      <section id="faq" class="py-20 lg:py-28">
        <div class="mx-auto max-w-4xl px-5 lg:px-8"><p class="section-label">সাধারণ প্রশ্ন</p><h2 class="mt-3 text-4xl font-black sm:text-5xl">যাওয়ার আগে যা জানা ভালো</h2><div class="mt-8 divide-y divide-stone-300 border-y border-stone-300">{faq.map(([q,a]) => <details class="group py-5"><summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-5 text-lg font-black"><span>{q}</span><span class="text-[#c5222a] transition group-open:rotate-45">＋</span></summary><p class="max-w-3xl pt-4 leading-7 text-stone-700">{a}</p></details>)}</div></div>
      </section>

      <section class="pb-20 lg:pb-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="relative overflow-hidden rounded-[2.5rem] bg-neutral-950 text-white"><img src={photoAlt} alt="কেন্দ্রীয় শহীদ মিনারের আরেকটি বাস্তব দৃশ্য" class="absolute inset-0 h-full w-full object-cover opacity-35" loading="lazy" /><div class="relative p-8 sm:p-12 lg:p-16"><p class="text-xs font-black uppercase tracking-[.18em] text-red-400">বিশ্বস্ত তথ্যসূত্র</p><h2 class="mt-3 max-w-2xl text-3xl font-black sm:text-4xl">স্মৃতি বোঝার জন্য উৎসে ফিরে যান</h2><div class="mt-7 flex flex-wrap gap-3"><a href="https://beautifulbangladesh.gov.bd/loc/dhaka/92" rel="noopener" class="focus-ring rounded-full border border-white/30 px-5 py-3 font-bold no-underline hover:bg-white hover:text-black">বাংলাদেশ ট্যুরিজম বোর্ড</a><a href="https://en.banglapedia.org/index.php?title=Shaheed_Minar" rel="noopener" class="focus-ring rounded-full border border-white/30 px-5 py-3 font-bold no-underline hover:bg-white hover:text-black">বাংলাপিডিয়া</a><a href="https://www.unesco.org/en/days/mother-language" rel="noopener" class="focus-ring rounded-full border border-white/30 px-5 py-3 font-bold no-underline hover:bg-white hover:text-black">ইউনেস্কো</a></div></div></div>
        </div>
      </section>
    </main>

    <footer class="border-t border-stone-300 bg-[#ede5da]">
      <div class="mx-auto max-w-7xl px-5 py-10 lg:px-8"><div class="flex flex-col justify-between gap-8 sm:flex-row"><div><img src="/assets/logo.svg" width="250" height="60" alt="কেন্দ্রীয় শহীদ মিনার" class="h-12 w-auto" /><p class="mt-4 max-w-lg text-sm leading-6 text-stone-600">এই ওয়েবসাইটটি একটি স্বাধীন ভ্রমণ-তথ্য গাইড; এটি কেন্দ্রীয় শহীদ মিনার, ঢাকা বিশ্ববিদ্যালয়, বাংলাদেশ সরকার বা কোনো সরকারি প্রতিষ্ঠানের অফিসিয়াল ওয়েবসাইট নয়।</p></div><div class="flex flex-wrap items-start gap-4 text-sm font-bold"><a href="#history">ইতিহাস</a><a href="#visit">ভ্রমণ</a><a href="#map">মানচিত্র</a><button id="cookie-settings" type="button" class="cursor-pointer border-0 bg-transparent p-0 font-bold underline">কুকি পছন্দ</button></div></div><div class="mt-8 border-t border-stone-300 pt-5 text-xs leading-5 text-stone-500">ছবি: Salim Khandoker, Wikimedia Commons, CC BY-SA 3.0. ঐতিহাসিক তথ্যের মূল সূত্র: বাংলাদেশ ট্যুরিজম বোর্ড, বাংলাপিডিয়া ও ইউনেস্কো।</div></div>
    </footer>

    <div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-50 hidden max-w-xl rounded-3xl border border-stone-700 bg-[#171515] p-5 text-white shadow-2xl sm:left-auto sm:right-5">
      <p class="font-black">পরিমাপের কুকি</p><p class="mt-2 text-sm leading-6 text-stone-300">সাইটের ব্যবহার বুঝতে Google Analytics 4 ব্যবহার করা হয়। চাইলে অনুমতি দিতে বা প্রত্যাখ্যান করতে পারেন।</p><div class="mt-4 flex gap-3"><button data-consent="accept" class="focus-ring rounded-full bg-[#c5222a] px-5 py-2 text-sm font-bold">অনুমতি দিন</button><button data-consent="deny" class="focus-ring rounded-full border border-white/25 px-5 py-2 text-sm font-bold">প্রত্যাখ্যান</button></div>
    </div>

    <script is:inline>
      (() => {
        const key = 'csm-analytics-consent';
        const id = 'G-HXM22WWPKP';
        const banner = document.getElementById('cookie-banner');
        const settings = document.getElementById('cookie-settings');
        const loadGA = () => {
          if (window.__csmGA) return;
          window.__csmGA = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', id, { anonymize_ip: true });
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
        };
        const set = (value) => {
          localStorage.setItem(key, value);
          banner?.classList.add('hidden');
          if (value === 'accepted') loadGA();
        };
        const current = localStorage.getItem(key);
        if (current === 'accepted') loadGA();
        else if (!current) banner?.classList.remove('hidden');
        banner?.querySelector('[data-consent="accept"]')?.addEventListener('click', () => set('accepted'));
        banner?.querySelector('[data-consent="deny"]')?.addEventListener('click', () => set('denied'));
        settings?.addEventListener('click', () => banner?.classList.remove('hidden'));
      })();
    </script>
  </body>
</html>
