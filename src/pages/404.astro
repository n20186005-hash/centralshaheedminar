---
import '../styles/global.css';
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>পৃষ্ঠা পাওয়া যায়নি — কেন্দ্রীয় শহীদ মিনার</title>
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen grid place-items-center p-6">
    <main class="text-center max-w-xl">
      <img src="/assets/logo.svg" width="300" height="72" alt="কেন্দ্রীয় শহীদ মিনার" class="mx-auto mb-8" />
      <p class="section-label">৪০৪</p>
      <h1 class="text-4xl font-black mt-2">পৃষ্ঠা পাওয়া যায়নি</h1>
      <p class="mt-4 text-stone-600">আপনি যে ঠিকানাটি খুঁজছেন তা এই গাইডে নেই।</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="focus-ring rounded-full bg-neutral-950 px-6 py-3 text-white no-underline">মূল পাতায় ফিরুন</a>
        <a href="/en/" hreflang="en" class="focus-ring rounded-full border border-neutral-900 px-6 py-3 no-underline">English version</a>
      </div>
    </main>
  </body>
</html>
