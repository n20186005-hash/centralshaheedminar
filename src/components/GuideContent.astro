---
import { ATTRACTION, SOURCES } from '../data/site';
import { guides, guideNavLabel, type GuideId } from '../content/guides';
import { localizedPath, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  id: GuideId;
}

const { locale, id } = Astro.props;
const c = guides[id][locale];
const t = ui[locale];
const homeHref = localizedPath(locale, '/');
const sourceLinks = SOURCES.map((source) => ({ href: source.href, label: source[locale] }));
const siblings = (Object.keys(guides) as GuideId[])
  .filter((key) => key !== id)
  .map((key) => ({ href: localizedPath(locale, `/${key}/`), label: guideNavLabel[key][locale], title: guides[key][locale].h1 }));
---

<section class="border-b border-stone-300/70 bg-[#141313] text-white">
  <div class="mx-auto max-w-4xl px-5 py-16 lg:px-8 lg:py-24">
    <nav aria-label={locale === 'bn' ? 'রুট' : 'Breadcrumb'} class="text-sm text-stone-400">
      <a href={homeHref} class="hover:text-white">{t.breadcrumbHome}</a>
      <span class="px-2">/</span>
      <span class="text-stone-200">{c.h1}</span>
    </nav>
    <h1 class="mt-6 text-4xl font-black leading-tight sm:text-5xl">{c.h1}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-300">{c.lead}</p>
  </div>
</section>

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <p class="mb-8 text-sm leading-7 text-stone-600">{locale === 'bn' ? 'তথ্য যাচাই: ২৬ অক্টোবর ২০২৬। বর্তমান প্রবেশ, ফি, চলাচল ও আশপাশের স্থানগুলির সময় আলাদাভাবে নিশ্চিত করুন। প্রথম স্মৃতিস্তম্ভ ভাঙার দিন নিয়ে সূত্রভেদ আছে: ট্যুরিজম বোর্ড ২৪ ফেব্রুয়ারি, বাংলাপিডিয়া ২৬ ফেব্রুয়ারি ১৯৫২ বলে।' : 'Checked 26 October 2026. Confirm current access, charges, travel routes and separate opening arrangements for nearby places. Sources differ on the demolition of the first memorial: the Tourism Board gives 24 February, Banglapedia 26 February 1952.'}</p>
    <div class="space-y-12">
      {
        c.sections.map((section) => (
          <article>
            <h2 class="text-2xl font-black sm:text-3xl">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p class="mt-4 leading-8 text-stone-700">{paragraph}</p>
            ))}
            {section.bullets && (
              <ul class="mt-5 space-y-3">
                {section.bullets.map((bullet) => (
                  <li class="memorial-card rounded-2xl p-4 leading-7 text-stone-700">{bullet}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="faq" class="border-y border-stone-300/70 bg-white/50 py-16 lg:py-24">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <p class="section-label">{t.labels.faqLabel}</p>
    <h2 class="mt-3 text-3xl font-black sm:text-4xl">{t.labels.faq}</h2>
    <div class="mt-8 divide-y divide-stone-300 border-y border-stone-300">
      {
        c.faq.map(([question, answer]) => (
          <details class="group py-5">
            <summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-5 text-lg font-black">
              <span>{question}</span>
              <span class="text-[#c5222a] transition group-open:rotate-45">＋</span>
            </summary>
            <p class="max-w-3xl pt-4 leading-7 text-stone-700">{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="py-16 lg:py-24">
  <div class="mx-auto grid max-w-4xl gap-8 px-5 lg:px-8">
    <div class="relative overflow-hidden rounded-[2rem] bg-neutral-950 text-white">
      <img src={ATTRACTION.photos.alt} alt={ATTRACTION.name[locale]} class="absolute inset-0 h-full w-full object-cover opacity-35" loading="lazy" />
      <div class="relative p-8 sm:p-10">
        <p class="text-xs font-black uppercase tracking-[.18em] text-red-400">{t.sourcesLabel}</p>
        <h2 class="mt-3 max-w-2xl text-2xl font-black sm:text-3xl">{t.labels.sources}</h2>
        <div class="mt-6 flex flex-wrap gap-3">
          {sourceLinks.map((source) => (
            <a href={source.href} rel="noopener" class="focus-ring rounded-full border border-white/30 px-5 py-3 font-bold no-underline hover:bg-white hover:text-black">{source.label}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <a href={homeHref} class="focus-ring rounded-full bg-neutral-950 px-5 py-3 font-bold text-white no-underline">{t.labels.backHome}</a>
      {siblings.map((item) => (
        <a href={item.href} title={item.title} class="focus-ring rounded-full border border-neutral-900 px-5 py-3 font-bold no-underline hover:bg-neutral-950 hover:text-white">{item.label}</a>
      ))}
    </div>
  </div>
</section>
