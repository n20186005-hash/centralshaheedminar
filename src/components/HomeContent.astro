---
import { ATTRACTION, SOURCES } from '../data/site';
import { homeContent } from '../content/home';
import { localizedPath, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = homeContent[locale];
const t = ui[locale];
const sourceLinks = SOURCES.map((source) => ({ href: source.href, label: source[locale] }));
const guideCards = c.guides.items.map((item) => ({ ...item, href: localizedPath(locale, item.href) }));
---

<section class="relative min-h-[86vh] overflow-hidden bg-neutral-950 text-white">
  <img
    src={ATTRACTION.photos.hero}
    alt={c.hero.imageAlt}
    class="absolute inset-0 h-full w-full object-cover object-center opacity-65"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-black/20"></div>
  <div class="absolute inset-0 pattern-lines opacity-30"></div>
  <div class="relative mx-auto flex min-h-[86vh] max-w-7xl items-end px-5 pb-14 pt-20 lg:px-8 lg:pb-20">
    <div class="max-w-4xl">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/25 bg-black/25 px-4 py-2 text-sm backdrop-blur">
        <span class="h-2.5 w-2.5 rounded-full bg-[#c5222a]"></span> {c.hero.badge}
      </p>
      <h1 class="text-5xl font-black leading-[1.06] tracking-tight sm:text-6xl lg:text-8xl">
        {c.hero.headingLead}<br /><span class="text-[#e34a50]">{c.hero.headingAccent}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-200 sm:text-xl">{c.hero.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        {c.hero.chips.map((chip) => <span class="rounded-full bg-white/10 px-4 py-2 backdrop-blur">{chip}</span>)}
      </div>
    </div>
  </div>
  <div class="absolute bottom-4 right-4 rounded-md bg-black/60 px-3 py-2 text-[11px] text-white/80">{ATTRACTION.photoCredit[locale]}</div>
</section>

<section class="border-b border-stone-300/70 bg-[#141313] text-white">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-white/10 sm:grid-cols-4">
    <div class="bg-[#141313] p-5 sm:p-7"><p class="text-xs text-stone-400">{t.facts.type}</p><p class="mt-1 font-bold">{c.facts.type}</p></div>
    <div class="bg-[#141313] p-5 sm:p-7"><p class="text-xs text-stone-400">{t.facts.location}</p><p class="mt-1 font-bold">{c.facts.location}</p></div>
    <div class="bg-[#141313] p-5 sm:p-7"><p class="text-xs text-stone-400">{t.facts.plusCode}</p><p class="mt-1 font-bold">{c.facts.plusCode}</p></div>
    <div class="bg-[#141313] p-5 sm:p-7"><p class="text-xs text-stone-400">{t.facts.duration}</p><p class="mt-1 font-bold">{c.facts.duration}</p></div>
  </div>
</section>

<section id="history" class="pattern-lines py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[.9fr_1.1fr] lg:px-8">
    <div class="lg:sticky lg:top-8 lg:self-start">
      <p class="section-label">{c.history.label}</p>
      <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">{c.history.title}</h2>
      <p class="mt-6 text-lg leading-8 text-stone-700">{c.history.lead}</p>
      <a href={c.history.cta.href} rel="noopener" class="focus-ring mt-7 inline-flex rounded-full border border-neutral-900 px-5 py-3 font-bold no-underline hover:bg-neutral-950 hover:text-white">{c.history.cta.text}</a>
    </div>
    <div class="space-y-5">
      {c.history.cards.map((card) => (
        <article class="memorial-card rounded-[2rem] p-7 sm:p-9">
          <p class="text-sm font-black text-[#a31d24]">{card.year}</p>
          <h3 class="mt-2 text-2xl font-black">{card.title}</h3>
          <p class="mt-3 leading-7 text-stone-700">{card.text}</p>
        </article>
      ))}
      <article class="rounded-[2rem] bg-[#c5222a] p-7 text-white sm:p-9">
        <p class="text-sm font-black text-red-100">{c.history.unesco.label}</p>
        <h3 class="mt-2 text-2xl font-black">{c.history.unesco.title}</h3>
        <p class="mt-3 leading-7 text-red-50">{c.history.unesco.text}</p>
        <a href={c.history.unesco.href} rel="noopener" class="focus-ring mt-5 inline-block font-bold underline">{c.history.unesco.linkText}</a>
      </article>
    </div>
  </div>
</section>

<section class="bg-[#171515] py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <figure class="relative overflow-hidden rounded-[2.5rem]">
        <img src={ATTRACTION.photos.wide} alt={c.architecture.imageAlt} class="aspect-[4/3] w-full object-cover" loading="lazy" />
        <figcaption class="photo-credit absolute inset-x-0 bottom-0 px-5 pb-4 pt-16 text-xs text-stone-200">{ATTRACTION.photoCredit[locale]}</figcaption>
      </figure>
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-red-400">{c.architecture.label}</p>
        <h2 class="mt-3 text-4xl font-black sm:text-5xl">{c.architecture.title}</h2>
        <p class="mt-6 text-lg leading-8 text-stone-300">{c.architecture.text}</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {c.architecture.facts.map((fact) => (
            <div class="rounded-2xl border border-white/15 p-5"><p class="text-xs text-stone-400">{fact.label}</p><p class="mt-1 text-xl font-bold">{fact.value}</p></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section id="visit" class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="section-label">{c.visit.label}</p>
    <h2 class="mt-3 max-w-3xl text-4xl font-black sm:text-5xl">{c.visit.title}</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {c.visit.cards.map((card) => (
        <article class="memorial-card rounded-3xl p-7">
          <span class="text-3xl">{card.icon}</span>
          <h3 class="mt-5 text-xl font-black">{card.title}</h3>
          <p class="mt-3 leading-7 text-stone-700">{card.text}</p>
        </article>
      ))}
      <article class="memorial-card rounded-3xl p-7 md:col-span-2 xl:col-span-3">
        <span class="text-3xl">🚇</span>
        <h3 class="mt-5 text-2xl font-black">{c.visit.transport.title}</h3>
        <div class="mt-5 grid gap-5 sm:grid-cols-3">
          {c.visit.transport.items.map((item) => (
            <div>
              <p class="font-black">{item.title}</p>
              <p class="mt-2 leading-7 text-stone-700" set:html={item.text}></p>
            </div>
          ))}
        </div>
      </article>
    </div>
    <p class="mt-5 text-xs leading-5 text-stone-500">{c.visit.note}</p>
  </div>
</section>

<section class="bg-[#c5222a] py-20 text-white lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 lg:grid-cols-[1fr_.8fr] lg:px-8">
    <div>
      <p class="text-xs font-black uppercase tracking-[.18em] text-red-100">{c.route.label}</p>
      <h2 class="mt-3 text-4xl font-black sm:text-5xl">{c.route.title}</h2>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-red-50">{c.route.text}</p>
    </div>
    <ol class="space-y-3 text-lg font-bold">
      {c.route.steps.map((step, index) => <li class="rounded-2xl bg-white/10 p-5">{index + 1} · {step}</li>)}
    </ol>
  </div>
</section>

<section class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-7 lg:grid-cols-[.75fr_1.25fr]">
      <figure class="relative overflow-hidden rounded-[2.5rem]">
        <img src={ATTRACTION.photos.portrait} alt={c.photos.imageAlt} class="h-full min-h-[420px] w-full object-cover" loading="lazy" />
        <figcaption class="photo-credit absolute inset-x-0 bottom-0 px-5 pb-4 pt-16 text-xs text-white">{ATTRACTION.photoCredit[locale]}</figcaption>
      </figure>
      <div class="grid gap-7 sm:grid-cols-2">
        {c.photos.spots.map((spot) => (
          <article class="memorial-card rounded-[2rem] p-7 sm:p-8">
            <p class="section-label">{spot.label}</p>
            <h3 class="mt-3 text-2xl font-black">{spot.title}</h3>
            <p class="mt-4 leading-7 text-stone-700">{spot.text}</p>
          </article>
        ))}
        <article class="rounded-[2rem] bg-[#171515] p-7 text-white sm:col-span-2 sm:p-8">
          <p class="text-xs font-black uppercase tracking-[.16em] text-red-400">{c.photos.etiquette.label}</p>
          <p class="mt-4 text-lg leading-8 text-stone-300">{c.photos.etiquette.text}</p>
        </article>
      </div>
    </div>
  </div>
</section>

<section id="nearby" class="border-y border-stone-300/70 bg-white/50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="section-label">{c.nearby.label}</p>
        <h2 class="mt-3 text-4xl font-black">{c.nearby.title}</h2>
        <div class="mt-7 space-y-4">
          {c.nearby.places.map((place) => (
            <div class="memorial-card rounded-2xl p-5">
              <h3 class="font-black">{place.title}</h3>
              <p class="mt-1 text-stone-600">{place.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="section-label">{c.nearby.food.label}</p>
        <h2 class="mt-3 text-4xl font-black">{c.nearby.food.title}</h2>
        <p class="mt-5 leading-7 text-stone-700">{c.nearby.food.text}</p>
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          {c.nearby.food.types.map((type) => (
            <div class="rounded-2xl bg-[#171515] p-5 text-white">
              <p class="text-sm text-stone-400">{type.label}</p>
              <p class="mt-1 text-xl font-black">{type.value}</p>
            </div>
          ))}
        </div>
        <div class="mt-7 rounded-3xl border border-[#c5222a]/30 bg-red-50 p-6">
          <h3 class="font-black text-[#971b20]">{c.nearby.food.plan.title}</h3>
          <p class="mt-2 leading-7 text-stone-700">{c.nearby.food.plan.text}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="section-label">{c.stay.label}</p>
    <h2 class="mt-3 text-4xl font-black">{c.stay.title}</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {c.stay.areas.map((area) => (
        <article class="memorial-card rounded-3xl p-7">
          <h3 class="text-xl font-black">{area.title}</h3>
          <p class="mt-3 leading-7 text-stone-700">{area.text}</p>
        </article>
      ))}
    </div>
    <p class="mt-5 text-sm text-stone-500">{c.stay.note}</p>
  </div>
</section>

<section id="map" class="bg-[#171515] py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-red-400">{c.map.label}</p>
        <h2 class="mt-3 text-4xl font-black sm:text-5xl">{c.map.title}</h2>
      </div>
      <a href={ATTRACTION.mapsUrl} rel="noopener" class="focus-ring rounded-full bg-white px-5 py-3 font-bold text-neutral-950 no-underline">{t.labels.openMap}</a>
    </div>
    <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-black">
      <iframe
        title={c.map.iframeTitle}
        src={ATTRACTION.mapsEmbed}
        width="100%"
        height="520"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div><p class="text-xs text-stone-500">{t.labels.address}</p><p class="mt-1 font-bold">{ATTRACTION.addressLocal[locale]}</p></div>
      <div><p class="text-xs text-stone-500">{t.labels.coordinates}</p><p class="mt-1 font-bold">{ATTRACTION.geo.latitude}, {ATTRACTION.geo.longitude}</p></div>
      <div><p class="text-xs text-stone-500">{t.labels.plusCode}</p><p class="mt-1 font-bold">{ATTRACTION.plusCode}, {ATTRACTION.city[locale]}</p></div>
    </div>
  </div>
</section>

<section id="faq" class="py-20 lg:py-28">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <p class="section-label">{t.labels.faqLabel}</p>
    <h2 class="mt-3 text-4xl font-black sm:text-5xl">{t.labels.faq}</h2>
    <div class="mt-8 divide-y divide-stone-300 border-y border-stone-300">
      {c.faq.items.map(([question, answer]) => (
        <details class="group py-5">
          <summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-5 text-lg font-black">
            <span>{question}</span>
            <span class="text-[#c5222a] transition group-open:rotate-45">＋</span>
          </summary>
          <p class="max-w-3xl pt-4 leading-7 text-stone-700">{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="border-t border-stone-300/70 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="section-label">{c.guides.label}</p>
    <h2 class="mt-3 text-4xl font-black sm:text-5xl">{c.guides.title}</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {guideCards.map((item) => (
        <a href={item.href} class="focus-ring memorial-card block rounded-3xl p-7 no-underline">
          <h3 class="text-xl font-black">{item.title}</h3>
          <p class="mt-3 leading-7 text-stone-700">{item.text}</p>
          <span class="mt-4 inline-block font-bold text-[#971b20]">{t.readMore} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="pb-20 lg:pb-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-neutral-950 text-white">
      <img src={ATTRACTION.photos.alt} alt={c.hero.imageAlt} class="absolute inset-0 h-full w-full object-cover opacity-35" loading="lazy" />
      <div class="relative p-8 sm:p-12 lg:p-16">
        <p class="text-xs font-black uppercase tracking-[.18em] text-red-400">{t.sourcesLabel}</p>
        <h2 class="mt-3 max-w-2xl text-3xl font-black sm:text-4xl">{t.labels.sources}</h2>
        <div class="mt-7 flex flex-wrap gap-3">
          {sourceLinks.map((source) => (
            <a href={source.href} rel="noopener" class="focus-ring rounded-full border border-white/30 px-5 py-3 font-bold no-underline hover:bg-white hover:text-black">{source.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
